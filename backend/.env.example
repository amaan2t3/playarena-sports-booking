# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/playarena)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/playarena?retryWrites=true&w=majority
MONGODB_DB_NAME=playarena

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Initial administrator account (required in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password
ADMIN_NAME=PlayArena Admin
 
# Frontend Client URL
CLIENT_URL=http://localhost:5173
